# Copy to .env to switch adapters from demo-fixture mode to live APIs.
# Leaving all of these blank is fine -- the app runs entirely on labelled
# demo fixtures that mirror the real response shapes documented in the brief.

PORT=8787

# LTA DataMall (https://datamall.lta.gov.sg) -- register for a free AccountKey.
LTA_ACCOUNT_KEY=

# OneMap (https://www.onemap.gov.sg/apidocs) -- email/password login token.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Vertex AI (Gemini) for the transit-copilot narrative. Requires a GCP project
# with Vertex AI enabled and Application Default Credentials configured
# (gcloud auth application-default login) or a service-account key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-flash
GOOGLE_APPLICATION_CREDENTIALS=
